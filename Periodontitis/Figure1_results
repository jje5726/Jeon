############################################################
## 7. PCA plot
############################################################

plot_pca <- function(expr_mat, meta, title) {
  
  pca <- prcomp(t(expr_mat), scale. = TRUE)
  
  pca_df <- as.data.frame(pca$x[, 1:2]) %>%
    rownames_to_column("sample") %>%
    left_join(
      meta %>% rownames_to_column("sample"),
      by = "sample"
    )
  
  pc_var <- round(100 * summary(pca)$importance[2, 1:2], 1)
  
  ggplot(pca_df, aes(PC1, PC2, color = group)) +
    geom_point(size = 2.8, alpha = 0.9) +
    stat_ellipse(linewidth = 0.7, linetype = "dashed") +
    scale_color_manual(values = c(
      "Healthy" = "#4DBBD5",
      "Periodontitis" = "#E64B35"
    )) +
    labs(
      title = title,
      x = paste0("PC1 (", pc_var[1], "%)"),
      y = paste0("PC2 (", pc_var[2], "%)"),
      color = NULL
    ) +
    theme_classic(base_size = 11) +
    theme(
      plot.title = element_text(face = "bold", size = 12),
      axis.title = element_text(face = "bold"),
      axis.text = element_text(color = "black"),
      legend.title = element_blank()
    )
}

