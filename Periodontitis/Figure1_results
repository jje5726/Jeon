############################################################
## 4. Probe ID -> Gene Symbol using fData()
############################################################

convert_probe_to_symbol_from_fdata <- function(expr_mat, fdata) {
  
  anno <- fdata %>%
    as.data.frame() %>%
    dplyr::select(ID, `Gene Symbol`) %>%
    dplyr::rename(
      PROBEID = ID,
      SYMBOL_raw = `Gene Symbol`
    ) %>%
    dplyr::mutate(
      SYMBOL = stringr::str_split(SYMBOL_raw, " /// ", simplify = TRUE)[, 1],
      SYMBOL = trimws(SYMBOL)
    ) %>%
    dplyr::filter(
      !is.na(SYMBOL),
      SYMBOL != "",
      SYMBOL != "---"
    ) %>%
    dplyr::select(PROBEID, SYMBOL) %>%
    dplyr::distinct()
  
  expr_df <- expr_mat %>%
    as.data.frame() %>%
    tibble::rownames_to_column("PROBEID") %>%
    dplyr::inner_join(anno, by = "PROBEID") %>%
    dplyr::select(-PROBEID) %>%
    dplyr::group_by(SYMBOL) %>%
    dplyr::summarise(
      dplyr::across(where(is.numeric), ~ mean(.x, na.rm = TRUE)),
      .groups = "drop"
    ) %>%
    tibble::column_to_rownames("SYMBOL") %>%
    as.matrix()
  
  return(expr_df)
}

