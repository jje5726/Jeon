############################################################
## 12. KEGG dotplot
############################################################

plot_enrich_dot <- function(enrich_obj, title, n = 5) {
  
  enrich_df <- as.data.frame(enrich_obj)
  
  if (is.null(enrich_obj) || nrow(enrich_df) == 0) {
    return(
      ggplot() +
        annotate("text", x = 0, y = 0, label = "No significant terms", size = 4) +
        labs(title = title) +
        theme_void() +
        theme(
          plot.title = element_text(face = "bold", size = 12)
        )
    )
  }
  
  dotplot(enrich_obj, showCategory = n) +
    labs(title = title) +
    theme(
      plot.title = element_text(face = "bold", size = 12),
      axis.title = element_text(face = "bold"),
      axis.text.y = element_text(size = 8, color = "black"),
      axis.text.x = element_text(color = "black"),
      legend.title = element_text(face = "bold"),
      legend.text = element_text(size = 8)
    )
}

