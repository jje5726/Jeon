############################################################
## 5. limma DEG analysis
## cutoff: P.Value < 0.05 and |logFC| >= 1
############################################################

run_limma_deg <- function(expr_mat, meta, group_col = "group") {
  
  group <- factor(meta[[group_col]], levels = c("Healthy", "Periodontitis"))
  
  design <- model.matrix(~ 0 + group)
  colnames(design) <- levels(group)
  
  fit <- lmFit(expr_mat, design)
  
  contrast <- makeContrasts(
    Periodontitis_vs_Healthy = Periodontitis - Healthy,
    levels = design
  )
  
  fit2 <- contrasts.fit(fit, contrast)
  fit2 <- eBayes(fit2)
  
  deg <- topTable(
    fit2,
    coef = "Periodontitis_vs_Healthy",
    number = Inf,
    adjust.method = "BH"
  ) %>%
    tibble::rownames_to_column("SYMBOL") %>%
    dplyr::mutate(
      regulation = dplyr::case_when(
        P.Value < 0.05 & logFC >= 1  ~ "Up",
        P.Value < 0.05 & logFC <= -1 ~ "Down",
        TRUE ~ "NS"
      )
    )
  
  return(deg)
}

